const fs = require('fs');
const path = require('path');
const sharp = require('sharp');
const ort = require('onnxruntime-node');

/**
 * ============================================================================
 *  Real inference for a YOLOv12-seg model exported to ONNX.
 *
 *  A YOLO-seg ONNX model does NOT output a ready-made mask image. It outputs:
 *    - "output0": [1, 4 + numClasses + 32, numBoxes]
 *        per box: [cx, cy, w, h, class0_score, class1_score, ..., 32 mask coeffs]
 *    - "output1": [1, 32, maskH, maskW]   (prototype masks, typically imgsz/4)
 *  A pixel mask for a detection = sigmoid(maskCoeffs · prototypes), cropped to
 *  its box and resized back to the original image. That reconstruction is
 *  most of the code below.
 * ============================================================================
 */

const MODEL_DIR = path.join(__dirname, '..', 'models');
const MODEL_PATH = path.join(MODEL_DIR, 'best.onnx');
const CLASSES_PATH = path.join(MODEL_DIR, 'classes.json');

const CONF_THRESHOLD = 0.25;
const IOU_THRESHOLD = 0.45;

// Extend/reorder to match your trained class names — used for overlay colors.
const DEFAULT_COLORS = ['#4FD1C5', '#C9A227', '#2E5EAA', '#E24B4B', '#8E7CC3', '#5AA469'];

let session = null;
let classNames = null;
let imgsz = 640;
let loadAttempted = false;

function isModelAvailable() {
  return fs.existsSync(MODEL_PATH) && fs.existsSync(CLASSES_PATH);
}

async function loadModel() {
  if (session || loadAttempted) return session;
  loadAttempted = true;
  if (!isModelAvailable()) return null;

  const meta = JSON.parse(fs.readFileSync(CLASSES_PATH, 'utf-8'));
  classNames = meta.names;
  imgsz = meta.imgsz || 640;
  session = await ort.InferenceSession.create(MODEL_PATH);
  console.log(`Loaded ONNX model with classes: ${classNames.join(', ')}`);
  return session;
}

function getModelInfo() {
  if (!classNames) return { loaded: false };
  return { loaded: true, classNames, imgsz };
}

// ---- Preprocessing: letterbox resize + normalize to CHW float32 ----
async function letterbox(imageBuffer, targetSize) {
  const image = sharp(imageBuffer);
  const meta = await image.metadata();
  const { width: w, height: h } = meta;

  const scale = Math.min(targetSize / w, targetSize / h);
  const newW = Math.round(w * scale);
  const newH = Math.round(h * scale);
  const padX = targetSize - newW;
  const padY = targetSize - newH;
  const left = Math.floor(padX / 2);
  const top = Math.floor(padY / 2);

  const resized = await image
    .resize(newW, newH)
    .extend({
      top,
      bottom: padY - top,
      left,
      right: padX - left,
      background: { r: 114, g: 114, b: 114 },
    })
    .removeAlpha()
    .raw()
    .toBuffer();

  // HWC uint8 -> CHW float32 normalized [0,1]
  const chw = new Float32Array(3 * targetSize * targetSize);
  const plane = targetSize * targetSize;
  for (let i = 0; i < plane; i++) {
    chw[i] = resized[i * 3] / 255;               // R
    chw[plane + i] = resized[i * 3 + 1] / 255;    // G
    chw[2 * plane + i] = resized[i * 3 + 2] / 255; // B
  }

  return { tensorData: chw, origW: w, origH: h, scale, padX: left, padY: top };
}

function sigmoid(x) {
  return 1 / (1 + Math.exp(-x));
}

function iou(a, b) {
  const x1 = Math.max(a.x1, b.x1);
  const y1 = Math.max(a.y1, b.y1);
  const x2 = Math.min(a.x2, b.x2);
  const y2 = Math.min(a.y2, b.y2);
  const inter = Math.max(0, x2 - x1) * Math.max(0, y2 - y1);
  const areaA = (a.x2 - a.x1) * (a.y2 - a.y1);
  const areaB = (b.x2 - b.x1) * (b.y2 - b.y1);
  return inter / (areaA + areaB - inter + 1e-9);
}

function nms(detections, iouThreshold) {
  const sorted = [...detections].sort((a, b) => b.conf - a.conf);
  const kept = [];
  for (const det of sorted) {
    if (kept.some((k) => k.classId === det.classId && iou(k, det) > iouThreshold)) continue;
    kept.push(det);
  }
  return kept;
}

// ---- Decode output0 into candidate detections, then NMS ----
function decodeDetections(output0, numClasses, numMaskCoeffs) {
  const dims = output0.dims; // [1, 4+numClasses+numMaskCoeffs, numBoxes]
  const attrs = dims[1];
  const numBoxes = dims[2];
  const data = output0.data;

  const candidates = [];
  for (let i = 0; i < numBoxes; i++) {
    let bestClass = -1;
    let bestScore = -Infinity;
    for (let c = 0; c < numClasses; c++) {
      const score = data[(4 + c) * numBoxes + i];
      if (score > bestScore) {
        bestScore = score;
        bestClass = c;
      }
    }
    if (bestScore < CONF_THRESHOLD) continue;

    const cx = data[0 * numBoxes + i];
    const cy = data[1 * numBoxes + i];
    const w = data[2 * numBoxes + i];
    const h = data[3 * numBoxes + i];

    const maskCoeffs = new Float32Array(numMaskCoeffs);
    for (let m = 0; m < numMaskCoeffs; m++) {
      maskCoeffs[m] = data[(4 + numClasses + m) * numBoxes + i];
    }

    candidates.push({
      classId: bestClass,
      conf: bestScore,
      x1: cx - w / 2,
      y1: cy - h / 2,
      x2: cx + w / 2,
      y2: cy + h / 2,
      maskCoeffs,
    });
  }

  return nms(candidates, IOU_THRESHOLD);
}

// ---- Reconstruct a binary mask for one detection from prototypes ----
function reconstructMask(det, proto, protoH, protoW, letterboxInfo, origW, origH) {
  const numMaskCoeffs = det.maskCoeffs.length;
  const planeSize = protoH * protoW;

  // mask value per prototype pixel = sigmoid(coeffs . proto[:, y, x])
  const maskSmall = new Float32Array(planeSize);
  for (let p = 0; p < planeSize; p++) {
    let sum = 0;
    for (let m = 0; m < numMaskCoeffs; m++) {
      sum += det.maskCoeffs[m] * proto[m * planeSize + p];
    }
    maskSmall[p] = sigmoid(sum);
  }

  // Box in proto-grid space (proto is imgsz/scaleFactor, typically imgsz/4)
  const gridScale = protoW / imgsz;
  const bx1 = Math.max(0, Math.floor(det.x1 * gridScale));
  const by1 = Math.max(0, Math.floor(det.y1 * gridScale));
  const bx2 = Math.min(protoW, Math.ceil(det.x2 * gridScale));
  const by2 = Math.min(protoH, Math.ceil(det.y2 * gridScale));

  // Zero out everything outside the box, then upsample proto-grid -> letterboxed imgsz
  const cropped = new Uint8Array(planeSize);
  for (let y = by1; y < by2; y++) {
    for (let x = bx1; x < bx2; x++) {
      const idx = y * protoW + x;
      cropped[idx] = maskSmall[idx] > 0.5 ? 255 : 0;
    }
  }

  return { cropped, protoH, protoW };
}

/**
 * Upsamples a proto-grid mask to the ORIGINAL image size, undoing the
 * letterbox padding/scale applied during preprocessing.
 */
async function maskToOriginalSize(cropped, protoH, protoW, letterboxInfo, origW, origH) {
  const { scale, padX, padY } = letterboxInfo;

  // proto grid -> letterboxed imgsz space
  const upscaled = await sharp(Buffer.from(cropped), { raw: { width: protoW, height: protoH, channels: 1 } })
    .resize(imgsz, imgsz, { kernel: 'nearest' })
    .raw()
    .toBuffer();

  // crop out the letterbox padding, then resize to original image dimensions
  const cropW = imgsz - Math.round(padX * 2 * (imgsz / imgsz)); // padX already in letterboxed px
  const contentW = Math.round(origW * scale);
  const contentH = Math.round(origH * scale);

  const final = await sharp(upscaled, { raw: { width: imgsz, height: imgsz, channels: 1 } })
    .extract({ left: padX, top: padY, width: contentW, height: contentH })
    .resize(origW, origH, { kernel: 'nearest' })
    .raw()
    .toBuffer();

  return final; // Uint8Array, 1 channel, origW*origH, values 0 or 255
}

async function segmentImage(imageBuffer, { colors = DEFAULT_COLORS } = {}) {
  await loadModel();
  if (!session) {
    throw new Error('ONNX model not loaded — call isModelAvailable() before segmentImage()');
  }

  const { tensorData, origW, origH, scale, padX, padY } = await letterbox(imageBuffer, imgsz);
  const inputTensor = new ort.Tensor('float32', tensorData, [1, 3, imgsz, imgsz]);

  const inputName = session.inputNames[0];
  const results = await session.run({ [inputName]: inputTensor });

  const output0 = results[session.outputNames[0]]; // detections
  const output1 = results[session.outputNames[1]]; // proto masks
  const numClasses = classNames.length;
  const numMaskCoeffs = output0.dims[1] - 4 - numClasses;
  const [, protoC, protoH, protoW] = output1.dims;

  const detections = decodeDetections(output0, numClasses, numMaskCoeffs);

  // Per-pixel class map for the whole image, built by painting each kept
  // detection's mask, highest confidence last (so it "wins" overlaps).
  const classMap = new Int16Array(origW * origH).fill(-1);
  const sortedByConf = [...detections].sort((a, b) => a.conf - b.conf);

  for (const det of sortedByConf) {
    const { cropped } = reconstructMask(det, output1.data, protoH, protoW, { scale, padX, padY }, origW, origH);
    const fullMask = await maskToOriginalSize(cropped, protoH, protoW, { scale, padX, padY }, origW, origH);
    for (let i = 0; i < fullMask.length; i++) {
      if (fullMask[i] > 0) classMap[i] = det.classId;
    }
  }

  // Build the overlay PNG + class breakdown + carriageway pixel extent from classMap
  const rgba = Buffer.alloc(origW * origH * 4);
  const classPixelCount = new Array(numClasses).fill(0);
  let carriagewayMinY = origH;
  let carriagewayMaxY = 0;
  const carriagewayIdx = classNames.indexOf('carriageway');

  for (let y = 0; y < origH; y++) {
    for (let x = 0; x < origW; x++) {
      const idx = y * origW + x;
      const cls = classMap[idx];
      if (cls >= 0) {
        classPixelCount[cls]++;
        const [r, g, b] = hexToRgb(colors[cls % colors.length]);
        rgba[idx * 4] = r;
        rgba[idx * 4 + 1] = g;
        rgba[idx * 4 + 2] = b;
        rgba[idx * 4 + 3] = 130; // semi-transparent overlay
        if (cls === carriagewayIdx) {
          if (y < carriagewayMinY) carriagewayMinY = y;
          if (y > carriagewayMaxY) carriagewayMaxY = y;
        }
      }
    }
  }

  const overlayBuffer = await sharp(rgba, { raw: { width: origW, height: origH, channels: 4 } }).png().toBuffer();
  const overlayPngBase64 = `data:image/png;base64,${overlayBuffer.toString('base64')}`;

  const totalPx = origW * origH;
  const classBreakdown = {};
  classNames.forEach((name, i) => {
    classBreakdown[name] = +((classPixelCount[i] / totalPx) * 100).toFixed(1);
  });

  const roadPixelLength = carriagewayIdx >= 0 && carriagewayMaxY > carriagewayMinY
    ? carriagewayMaxY - carriagewayMinY
    : 0;

  return {
    width: origW,
    height: origH,
    overlayPngBase64,
    classBreakdown,
    roadType: `inferred from trained model (${detections.length} detections)`,
    roadPixelLength,
  };
}

function hexToRgb(hex) {
  const n = parseInt(hex.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}

module.exports = { segmentImage, isModelAvailable, loadModel, getModelInfo };
